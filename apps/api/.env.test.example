# Copied/overridden in CI. Local: copy to .env.test and point at bridgecabs_test.
DATABASE_URL="postgresql://bridgecabs:localdevpassword@localhost:5432/bridgecabs_test"
REDIS_URL=redis://localhost:6379/1
NODE_ENV=test
JWT_ACCESS_SECRET=test-jwt-secret-not-for-production
JWT_REFRESH_TTL_DAYS=7
OTP_PEPPER=test-otp-pepper-not-for-production
OTP_DEV_CODE=000000
QUOTE_SECRET=test-quote-secret-not-for-production
ALLOW_FAKE_PAYMENTS=true
# High global cap so suites sharing one Redis IP do not 429 each other; login stays @Throttle(5).
THROTTLE_LIMIT=100000
BOOKING_THROTTLE_LIMIT=100000
# Optional — leave empty to exercise the fake card path.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=whsec_test_placeholder
