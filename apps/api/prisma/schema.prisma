generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Branch {
  id        String    @id @default(uuid())
  name      String
  city      String
  active     Boolean    @default(true)
  timezone   String     @default("America/Edmonton")
  currency   String     @default("CAD")
  gstRateBps          Int       @default(500)
  autoDispatchDefault Boolean   @default(false)
  offerTimeoutSeconds Int       @default(15)
  searchWindowSeconds Int       @default(120)
  centerLat           Float?
  centerLng           Float?
  // Placeholder until dispatch confirms how inside town is defined.
  townRadiusKm        Int       @default(15)
  createdAt           DateTime  @default(now())
  users      User[]
  vehicles   Vehicle[]
  drivers    Driver[]
  fareRules  FareRule[]
  bookings   Booking[]
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique // super_admin, branch_admin, dispatcher, customer_care, hr_admin, accounts_admin, driver, passenger
  users       User[]
  permissions RolePermission[]
}

model User {
  id            String         @id @default(uuid())
  email         String?        @unique
  phone         String?        @unique
  displayName   String?
  passwordHash  String?
  branchId      String?
  branch        Branch?        @relation(fields: [branchId], references: [id])
  roleId        String
  role          Role           @relation(fields: [roleId], references: [id])
  isActive      Boolean        @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime       @default(now())
  refreshTokens RefreshToken[]
  deviceTokens  DeviceToken[]
  driver        Driver?
  passenger     Passenger?
}

/// Append-only. Rows can contain phone numbers and other personal information.
/// Agree a retention period with counsel before production.
model AuditLog {
  id          String    @id @default(uuid())
  actorUserId String?
  actorType   ActorType
  entity      String
  entityId    String
  action      String
  before      Json?
  after       Json?
  createdAt   DateTime  @default(now())

  @@index([entity, entityId, createdAt])
}

enum DriverStatus {
  PENDING_DOCUMENTS
  PENDING_APPROVAL
  APPROVED
  SUSPENDED
  REJECTED
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum DocumentOwner {
  DRIVER
  VEHICLE
}

model VehicleType {
  id       String         @id @default(uuid())
  name     String         @unique // Sedan, SUV, Minivan, Luxury
  active    Boolean        @default(true)
  models    VehicleModel[]
  vehicles  Vehicle[]
  fareRules FareRule[]
  bookings  Booking[]
}

model VehicleMake {
  id     String         @id @default(uuid())
  name   String         @unique
  models VehicleModel[]
}

model VehicleModel {
  id            String      @id @default(uuid())
  makeId        String
  make          VehicleMake @relation(fields: [makeId], references: [id])
  vehicleTypeId String
  vehicleType   VehicleType @relation(fields: [vehicleTypeId], references: [id])
  name          String
  bodyType      String?
  vehicles      Vehicle[]

  @@unique([makeId, name])
}

model Vehicle {
  id            String                    @id @default(uuid())
  legacyId      Int?                      @unique
  branchId      String
  branch        Branch                    @relation(fields: [branchId], references: [id])
  modelId       String
  model         VehicleModel              @relation(fields: [modelId], references: [id])
  vehicleTypeId String
  vehicleType   VehicleType               @relation(fields: [vehicleTypeId], references: [id])
  plateNumber   String
  unitNumber    String? // taxi fleet unit number (dispatch shows "111", "123")
  year          Int
  color         String?
  seats         Int                       @default(4)
  active        Boolean                   @default(true)
  createdAt     DateTime                  @default(now())
  assignments   DriverVehicleAssignment[]
  documents     Document[]
  bookings      Booking[]
  offers        BookingOffer[]

  @@unique([branchId, plateNumber])
  @@index([branchId])
}

model Driver {
  id           String                    @id @default(uuid())
  legacyId     Int?                      @unique
  userId       String                    @unique
  user         User                      @relation(fields: [userId], references: [id])
  branchId     String
  branch       Branch                    @relation(fields: [branchId], references: [id])
  firstName    String
  lastName     String
  phone        String
  ladyDriverEligible Boolean?
  status           DriverStatus              @default(PENDING_DOCUMENTS)
  approvedAt       DateTime?
  approvedById     String?
  suspensionReason String?
  presenceVersion  Int                   @default(0)
  ratingAvg    Decimal                   @default(0) @db.Decimal(3, 2)
  ratingCount  Int                       @default(0)
  createdAt    DateTime                  @default(now())
  assignments  DriverVehicleAssignment[]
  documents    Document[]
  bookings     Booking[]
  offers       BookingOffer[]
  shifts       DriverShift[]
  locationConsents DriverLocationConsent[]

  @@index([branchId, status])
}

model DriverVehicleAssignment {
  id        String    @id @default(uuid())
  driverId  String
  driver    Driver    @relation(fields: [driverId], references: [id])
  vehicleId String
  vehicle   Vehicle   @relation(fields: [vehicleId], references: [id])
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  @@index([driverId, endedAt])
  @@index([vehicleId, endedAt])
}

enum ShiftEndReason {
  MANUAL
  CONNECTION_LOST
  ADMIN_FORCED
  SYSTEM
}

model DriverShift {
  id        String          @id @default(uuid())
  driverId  String
  driver    Driver          @relation(fields: [driverId], references: [id])
  vehicleId String
  branchId  String
  startedAt DateTime        @default(now())
  endedAt   DateTime?
  endReason ShiftEndReason?
  endedById String?
  endNote   String?

  @@index([driverId, startedAt])
  @@index([branchId, startedAt])
}

model DriverLocationLog {
  id         BigInt   @id @default(autoincrement())
  driverId   String
  bookingId  String?
  lat        Float
  lng        Float
  speedMps   Float?
  heading    Float?
  accuracyM  Float?
  recordedAt DateTime

  @@index([driverId, recordedAt])
  @@index([bookingId, recordedAt])
  @@index([recordedAt])
}

/// Acceptance of the driver location notice. Collection starts only after this, and only on shift.
model DriverLocationConsent {
  id            String   @id @default(uuid())
  driverId      String
  driver        Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  noticeVersion String
  acceptedAt    DateTime @default(now())

  @@unique([driverId, noticeVersion])
}

/// One row each time a branch or super admin reads location history.
model LocationAccessLog {
  id          String    @id @default(uuid())
  actorUserId String
  driverId    String
  branchId    String
  from        DateTime
  to          DateTime
  createdAt   DateTime  @default(now())

  @@index([driverId, createdAt])
  @@index([actorUserId, createdAt])
}

model Passenger {
  id            String    @id @default(uuid())
  legacyId      Int?      @unique
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id])
  firstName     String
  lastName      String?
  phone         String
  email         String?
  createdAt     DateTime  @default(now())
  blocked       Boolean   @default(false)
  blockReason   String?
  blockedAt     DateTime?
  unblockReason String?
  bookings      Booking[]
}

model DocumentType {
  id        String        @id @default(uuid())
  code      String        @unique // AB_DRIVERS_LICENCE, POLICE_CHECK_VSC, WORK_ELIGIBILITY, VEHICLE_REGISTRATION, VEHICLE_INSURANCE, TAXI_INSPECTION
  name      String
  owner     DocumentOwner
  required  Boolean       @default(true)
  hasExpiry Boolean       @default(true)
  documents Document[]
}

model Document {
  id             String         @id @default(uuid())
  documentTypeId String
  documentType   DocumentType   @relation(fields: [documentTypeId], references: [id])
  driverId       String?
  driver         Driver?        @relation(fields: [driverId], references: [id])
  vehicleId      String?
  vehicle        Vehicle?       @relation(fields: [vehicleId], references: [id])
  storageKey     String // R2 object key, never a public URL
  status         DocumentStatus @default(PENDING)
  expiresAt      DateTime?
  reviewedById   String?
  reviewedAt     DateTime?
  rejectionNote  String?
  createdAt      DateTime       @default(now())

  @@index([driverId])
  @@index([vehicleId])
  @@index([expiresAt])
}

model Permission {
  id    String           @id @default(uuid())
  code  String           @unique // e.g. "branches.read", "branches.write", "drivers.approve"
  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
}

enum BookingStatus {
  SCHEDULED
  CREATED
  SEARCHING_DRIVER
  MATCHED
  DRIVER_ASSIGNED
  DRIVER_ARRIVING
  DRIVER_ARRIVED
  TRIP_STARTED
  TRIP_COMPLETED
  PAYMENT_PENDING
  PAYMENT_COMPLETED
  CLOSED
  CANCELLED
  NO_DRIVER_FOUND
}

enum BookingSource {
  DISPATCH
  PASSENGER_APP
  DRIVER_APP
}

enum FareZone {
  INSIDE_TOWN
  OUT_OF_TOWN
}

enum PaymentMethod {
  CARD
  CASH
  WALLET
  ACCOUNT
}

enum PaymentStatus {
  UNPAID
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
}

enum StopType {
  PICKUP
  DROPOFF
  STOP
}

enum ActorType {
  SYSTEM
  STAFF
  PASSENGER
  DRIVER
}

enum AssignMethod {
  MANUAL
  AUTO
}

enum AssignMode {
  AUTO
  MANUAL
}

enum OfferStatus {
  OFFERED
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
}

enum AssignEndReason {
  REASSIGNED
  DRIVER_CANCELLED
  COMPLETED
  BOOKING_CANCELLED
  TIMEOUT
}

enum CancelReason {
  PASSENGER_REQUEST
  DRIVER_NO_SHOW
  PASSENGER_NO_SHOW
  DUPLICATE
  OPERATIONAL
  OTHER
}

model FareRule {
  id             String      @id @default(uuid())
  branchId       String
  branch         Branch      @relation(fields: [branchId], references: [id])
  vehicleTypeId  String
  vehicleType    VehicleType @relation(fields: [vehicleTypeId], references: [id])
  zone           FareZone
  title          String
  baseFareCents  Int
  perKmCents     Int
  perMinuteCents Int         @default(0)
  minFareCents   Int         @default(0)
  active         Boolean     @default(true)

  @@unique([branchId, vehicleTypeId, zone])
}

model Booking {
  id                   String        @id @default(uuid())
  trackingId           String        @unique // human-friendly, e.g. BC-7K3MQ9XT
  legacyId             Int?          @unique
  version              Int           @default(0) // optimistic locking
  branchId             String
  branch               Branch        @relation(fields: [branchId], references: [id])
  source               BookingSource
  status               BookingStatus @default(CREATED)
  assignMode           AssignMode    @default(AUTO)
  searchStartedAt      DateTime?
  passengerId          String? // partial unique: one booking that is not CANCELLED or CLOSED
  passenger            Passenger?    @relation(fields: [passengerId], references: [id])
  passengerName        String // snapshot: phone-in customers may have no account
  passengerPhone       String
  createdById          String? // staff or passenger user
  vehicleTypeId        String
  vehicleType          VehicleType   @relation(fields: [vehicleTypeId], references: [id])
  vanOnly              Boolean       @default(false)
  ladyDriverOnly       Boolean       @default(false)
  zone                 FareZone      @default(INSIDE_TOWN)
  corporateAccountId   String? // relation added when corporate accounts are built
  scheduledAt          DateTime? // UTC; null means "now"
  distanceMeters       Int
  durationSeconds      Int
  quotedFareCents      Int
  quotedTaxCents       Int
  fixedFareCents       Int? // dispatcher override
  finalFareCents       Int? // set at completion
  cancellationFeeCents Int           @default(0)
  paymentMethod        PaymentMethod @default(CASH)
  paymentStatus        PaymentStatus @default(UNPAID)
  notes                String?
  driverId             String? // current driver snapshot, cleared on un-assign
  driver               Driver?       @relation(fields: [driverId], references: [id])
  vehicleId            String?
  vehicle              Vehicle?      @relation(fields: [vehicleId], references: [id])
  cancelledBy          ActorType?
  cancelReason         CancelReason?
  cancelNote           String?
  assignedAt           DateTime?
  arrivedAt            DateTime?
  startedAt            DateTime?
  completedAt          DateTime?
  closedAt             DateTime?
  cancelledAt          DateTime?
  createdAt            DateTime      @default(now())
  stops                BookingStop[]
  history              BookingStatusHistory[]
  assignments          BookingAssignment[]
  offers               BookingOffer[]

  @@index([branchId, status, createdAt])
  @@index([driverId, status])
  @@index([passengerId, createdAt])
  @@index([scheduledAt])
}

model BookingStop {
  id        String    @id @default(uuid())
  bookingId String
  booking   Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  sequence  Int
  type      StopType
  address   String
  lat       Float
  lng       Float
  placeId   String?
  arrivedAt DateTime?

  @@unique([bookingId, sequence])
}

model BookingStatusHistory {
  id          String         @id @default(uuid())
  bookingId   String
  booking     Booking        @relation(fields: [bookingId], references: [id])
  fromStatus  BookingStatus?
  toStatus    BookingStatus
  actorType   ActorType
  actorUserId String?
  reason      String?
  metadata    Json?
  createdAt   DateTime       @default(now())

  @@index([bookingId, createdAt])
}

model BookingAssignment {
  id           String           @id @default(uuid())
  bookingId    String
  booking      Booking          @relation(fields: [bookingId], references: [id])
  driverId     String
  vehicleId    String
  method       AssignMethod
  assignedById String?
  assignedAt   DateTime         @default(now())
  endedAt      DateTime?
  endReason    AssignEndReason?

  @@index([driverId, assignedAt])
}

model BookingOffer {
  id                String      @id @default(uuid())
  bookingId         String
  booking           Booking     @relation(fields: [bookingId], references: [id])
  driverId          String
  driver            Driver      @relation(fields: [driverId], references: [id])
  vehicleId         String
  vehicle           Vehicle     @relation(fields: [vehicleId], references: [id])
  attempt           Int
  status            OfferStatus @default(OFFERED)
  distanceToPickupM Int
  offeredAt         DateTime    @default(now())
  expiresAt         DateTime
  respondedAt       DateTime?
  declineReason     String?

  @@index([bookingId, offeredAt])
  @@index([driverId, offeredAt])
}

model DeviceToken {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  token      String    @unique
  platform   String // ios | android
  appVersion String?
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?

  @@index([userId])
}

model IdempotencyKey {
  id           String   @id @default(uuid())
  userId       String
  key          String
  requestHash  String
  responseCode Int?
  responseBody Json?
  createdAt    DateTime @default(now())

  @@unique([userId, key])
}
