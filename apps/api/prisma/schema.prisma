generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Branch {
  id        String    @id @default(uuid())
  name      String
  city      String
  active     Boolean    @default(true)
  timezone   String     @default("America/Edmonton")
  currency   String     @default("CAD")
  gstRateBps          Int       @default(500)
  /// Platform commission in basis points of the pre-GST subtotal. Legacy
  /// branches stored a deduction % — import the real value later. Seed is 0.
  commissionBps       Int       @default(0)
  autoDispatchDefault Boolean   @default(false)
  offerTimeoutSeconds Int       @default(15)
  searchWindowSeconds Int       @default(120)
  centerLat           Float?
  centerLng           Float?
  // Placeholder until dispatch confirms how inside town is defined.
  townRadiusKm        Int       @default(15)
  createdAt           DateTime  @default(now())
  users           User[]
  vehicles        Vehicle[]
  drivers         Driver[]
  fareRules       FareRule[]
  bookings        Booking[]
  closingPeriods  ClosingPeriod[]
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique // super_admin, branch_admin, dispatcher, customer_care, hr_admin, accounts_admin, driver, passenger
  users       User[]
  permissions RolePermission[]
}

model User {
  id            String         @id @default(uuid())
  email         String?        @unique
  phone         String?        @unique
  displayName   String?
  passwordHash  String?
  branchId      String?
  branch        Branch?        @relation(fields: [branchId], references: [id])
  roleId        String
  role          Role           @relation(fields: [roleId], references: [id])
  isActive      Boolean        @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime       @default(now())
  refreshTokens RefreshToken[]
  deviceTokens  DeviceToken[]
  driver        Driver?
  passenger     Passenger?
}

/// Append-only. Rows can contain phone numbers and other personal information.
/// Agree a retention period with counsel before production.
model AuditLog {
  id          String    @id @default(uuid())
  actorUserId String?
  actorType   ActorType
  entity      String
  entityId    String
  action      String
  before      Json?
  after       Json?
  createdAt   DateTime  @default(now())

  @@index([entity, entityId, createdAt])
}

enum DriverStatus {
  PENDING_DOCUMENTS
  PENDING_APPROVAL
  APPROVED
  SUSPENDED
  REJECTED
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum DocumentOwner {
  DRIVER
  VEHICLE
}

model VehicleType {
  id       String         @id @default(uuid())
  name     String         @unique // Sedan, SUV, Minivan, Luxury
  active    Boolean        @default(true)
  models    VehicleModel[]
  vehicles  Vehicle[]
  fareRules FareRule[]
  bookings  Booking[]
}

model VehicleMake {
  id     String         @id @default(uuid())
  name   String         @unique
  models VehicleModel[]
}

model VehicleModel {
  id            String      @id @default(uuid())
  makeId        String
  make          VehicleMake @relation(fields: [makeId], references: [id])
  vehicleTypeId String
  vehicleType   VehicleType @relation(fields: [vehicleTypeId], references: [id])
  name          String
  bodyType      String?
  vehicles      Vehicle[]

  @@unique([makeId, name])
}

model Vehicle {
  id            String                    @id @default(uuid())
  legacyId      Int?                      @unique
  branchId      String
  branch        Branch                    @relation(fields: [branchId], references: [id])
  modelId       String
  model         VehicleModel              @relation(fields: [modelId], references: [id])
  vehicleTypeId String
  vehicleType   VehicleType               @relation(fields: [vehicleTypeId], references: [id])
  plateNumber   String
  unitNumber    String? // taxi fleet unit number (dispatch shows "111", "123")
  year          Int
  color         String?
  seats         Int                       @default(4)
  active        Boolean                   @default(true)
  createdAt     DateTime                  @default(now())
  assignments     DriverVehicleAssignment[]
  documents       Document[]
  bookings        Booking[]
  offers          BookingOffer[]
  leaseAgreements LeaseAgreement[]

  @@unique([branchId, plateNumber])
  @@index([branchId])
}

model Driver {
  id           String                    @id @default(uuid())
  legacyId     Int?                      @unique
  userId       String                    @unique
  user         User                      @relation(fields: [userId], references: [id])
  branchId     String
  branch       Branch                    @relation(fields: [branchId], references: [id])
  firstName    String
  lastName     String
  phone        String
  ladyDriverEligible Boolean?
  status           DriverStatus              @default(PENDING_DOCUMENTS)
  approvedAt       DateTime?
  approvedById     String?
  suspensionReason String?
  presenceVersion  Int                   @default(0)
  ratingAvg    Decimal                   @default(0) @db.Decimal(3, 2)
  ratingCount  Int                       @default(0)
  createdAt    DateTime                  @default(now())
  assignments  DriverVehicleAssignment[]
  documents    Document[]
  bookings     Booking[]
  offers       BookingOffer[]
  shifts       DriverShift[]
  locationConsents DriverLocationConsent[]
  leaseAgreements  LeaseAgreement[]
  payouts          DriverPayout[]

  @@index([branchId, status])
}

model DriverVehicleAssignment {
  id        String    @id @default(uuid())
  driverId  String
  driver    Driver    @relation(fields: [driverId], references: [id])
  vehicleId String
  vehicle   Vehicle   @relation(fields: [vehicleId], references: [id])
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  @@index([driverId, endedAt])
  @@index([vehicleId, endedAt])
}

enum ShiftEndReason {
  MANUAL
  CONNECTION_LOST
  ADMIN_FORCED
  SYSTEM
}

model DriverShift {
  id        String          @id @default(uuid())
  driverId  String
  driver    Driver          @relation(fields: [driverId], references: [id])
  vehicleId String
  branchId  String
  startedAt DateTime        @default(now())
  endedAt   DateTime?
  endReason ShiftEndReason?
  endedById String?
  endNote   String?

  @@index([driverId, startedAt])
  @@index([branchId, startedAt])
}

model DriverLocationLog {
  id         BigInt   @id @default(autoincrement())
  driverId   String
  bookingId  String?
  lat        Float
  lng        Float
  speedMps   Float?
  heading    Float?
  accuracyM  Float?
  recordedAt DateTime

  @@index([driverId, recordedAt])
  @@index([bookingId, recordedAt])
  @@index([recordedAt])
}

/// Acceptance of the driver location notice. Collection starts only after this, and only on shift.
model DriverLocationConsent {
  id            String   @id @default(uuid())
  driverId      String
  driver        Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  noticeVersion String
  acceptedAt    DateTime @default(now())

  @@unique([driverId, noticeVersion])
}

/// One row each time a branch or super admin reads location history.
model LocationAccessLog {
  id          String    @id @default(uuid())
  actorUserId String
  driverId    String
  branchId    String
  from        DateTime
  to          DateTime
  createdAt   DateTime  @default(now())

  @@index([driverId, createdAt])
  @@index([actorUserId, createdAt])
}

model Passenger {
  id             String                    @id @default(uuid())
  legacyId       Int?                      @unique
  userId         String                    @unique
  user           User                      @relation(fields: [userId], references: [id])
  firstName      String
  lastName       String?
  phone          String
  email          String?
  createdAt      DateTime                  @default(now())
  blocked        Boolean                   @default(false)
  blockReason    String?
  blockedAt      DateTime?
  unblockReason  String?
  bookings       Booking[]
  paymentMethods PassengerPaymentMethod[]
  stripeCustomer StripeCustomer?
}

model DocumentType {
  id        String        @id @default(uuid())
  code      String        @unique // AB_DRIVERS_LICENCE, POLICE_CHECK_VSC, WORK_ELIGIBILITY, VEHICLE_REGISTRATION, VEHICLE_INSURANCE, TAXI_INSPECTION
  name      String
  owner     DocumentOwner
  required  Boolean       @default(true)
  hasExpiry Boolean       @default(true)
  documents Document[]
}

model Document {
  id             String         @id @default(uuid())
  documentTypeId String
  documentType   DocumentType   @relation(fields: [documentTypeId], references: [id])
  driverId       String?
  driver         Driver?        @relation(fields: [driverId], references: [id])
  vehicleId      String?
  vehicle        Vehicle?       @relation(fields: [vehicleId], references: [id])
  storageKey     String // R2 object key, never a public URL
  status         DocumentStatus @default(PENDING)
  expiresAt      DateTime?
  reviewedById   String?
  reviewedAt     DateTime?
  rejectionNote  String?
  createdAt      DateTime       @default(now())

  @@index([driverId])
  @@index([vehicleId])
  @@index([expiresAt])
}

model Permission {
  id    String           @id @default(uuid())
  code  String           @unique // e.g. "branches.read", "branches.write", "drivers.approve"
  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
}

enum BookingStatus {
  SCHEDULED
  CREATED
  SEARCHING_DRIVER
  MATCHED
  DRIVER_ASSIGNED
  DRIVER_ARRIVING
  DRIVER_ARRIVED
  TRIP_STARTED
  TRIP_COMPLETED
  PAYMENT_PENDING
  PAYMENT_COMPLETED
  CLOSED
  CANCELLED
  NO_DRIVER_FOUND
}

enum BookingSource {
  DISPATCH
  PASSENGER_APP
  DRIVER_APP
}

enum FareZone {
  INSIDE_TOWN
  OUT_OF_TOWN
}

enum PaymentMethod {
  CARD
  CASH
  WALLET
  ACCOUNT
}

enum PaymentStatus {
  UNPAID
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
}

/// Outcome of one Payment attempt. Booking.paymentStatus is the summary.
enum PaymentRecordStatus {
  PENDING
  REQUIRES_ACTION
  AUTHORIZED
  CAPTURED
  FAILED
  CANCELLED
  REFUNDED
}

enum AccountType {
  DRIVER_BALANCE
  COMPANY_REVENUE
  GST_PAYABLE
  PAYMENT_CLEARING
  PASSENGER_WALLET
}

enum LedgerKind {
  TRIP_CASH
  TRIP_CARD
  ADJUSTMENT
  REVERSAL
  LEASE_DEDUCTION
  SETTLEMENT
}

/// Why this Payment row exists (card auth/capture vs overage vs refund).
enum PaymentPurpose {
  TRIP_AUTH_CAPTURE
  TRIP_OVERAGE
  REFUND
}

enum PayoutStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

enum ClosingStatus {
  DRAFT
  FINALIZED
}

enum StopType {
  PICKUP
  DROPOFF
  STOP
}

enum ActorType {
  SYSTEM
  STAFF
  PASSENGER
  DRIVER
}

enum AssignMethod {
  MANUAL
  AUTO
}

enum AssignMode {
  AUTO
  MANUAL
}

enum OfferStatus {
  OFFERED
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
}

enum AssignEndReason {
  REASSIGNED
  DRIVER_CANCELLED
  COMPLETED
  BOOKING_CANCELLED
  TIMEOUT
}

enum CancelReason {
  PASSENGER_REQUEST
  DRIVER_NO_SHOW
  PASSENGER_NO_SHOW
  DUPLICATE
  OPERATIONAL
  OTHER
}

model FareRule {
  id             String      @id @default(uuid())
  branchId       String
  branch         Branch      @relation(fields: [branchId], references: [id])
  vehicleTypeId  String
  vehicleType    VehicleType @relation(fields: [vehicleTypeId], references: [id])
  zone           FareZone
  title          String
  baseFareCents  Int
  perKmCents     Int
  perMinuteCents Int         @default(0)
  minFareCents   Int         @default(0)
  active         Boolean     @default(true)

  @@unique([branchId, vehicleTypeId, zone])
}

model Booking {
  id                   String        @id @default(uuid())
  trackingId           String        @unique // human-friendly, e.g. BC-7K3MQ9XT
  legacyId             Int?          @unique
  version              Int           @default(0) // optimistic locking
  branchId             String
  branch               Branch        @relation(fields: [branchId], references: [id])
  source               BookingSource
  status               BookingStatus @default(CREATED)
  assignMode           AssignMode    @default(AUTO)
  searchStartedAt      DateTime?
  passengerId          String? // partial unique: one booking that is not CANCELLED or CLOSED
  passenger            Passenger?    @relation(fields: [passengerId], references: [id])
  passengerName        String // snapshot: phone-in customers may have no account
  passengerPhone       String
  createdById          String? // staff or passenger user
  vehicleTypeId        String
  vehicleType          VehicleType   @relation(fields: [vehicleTypeId], references: [id])
  vanOnly              Boolean       @default(false)
  ladyDriverOnly       Boolean       @default(false)
  zone                 FareZone      @default(INSIDE_TOWN)
  corporateAccountId   String? // relation added when corporate accounts are built
  scheduledAt          DateTime? // UTC; null means "now"
  distanceMeters       Int
  durationSeconds      Int
  /// Pre-GST subtotal at quote/create time (`calcFare.subtotalCents`).
  quotedFareCents      Int
  /// GST on the quote (`calcFare.taxCents`).
  quotedTaxCents       Int
  fixedFareCents       Int? // dispatcher override
  /// GST-inclusive total at completion.
  finalFareCents       Int?
  /// Branch GST rate snapshotted when the booking is created.
  gstRateBps           Int           @default(500)
  /// Branch commission snapshotted when the trip is completed.
  commissionBps        Int?
  finalSubtotalCents   Int?
  finalTaxCents        Int?
  commissionCents      Int?
  driverEarningCents   Int?
  cancellationFeeCents Int           @default(0)
  paymentMethod        PaymentMethod @default(CASH)
  paymentStatus        PaymentStatus @default(UNPAID)
  /// Saved card used for CARD bookings (null for CASH).
  paymentMethodId      String?
  savedPaymentMethod   PassengerPaymentMethod? @relation(fields: [paymentMethodId], references: [id])
  /// Stripe PaymentIntent id for the authorize hold.
  stripePaymentIntentId String?
  /// Amount held at authorize (quote + buffer), GST-inclusive cents.
  authorizedAmountCents Int?
  /// AUTH_BUFFER_BPS snapshotted when the hold was created.
  authBufferBps        Int?
  notes                String?
  driverId             String? // current driver snapshot, cleared on un-assign
  driver               Driver?       @relation(fields: [driverId], references: [id])
  vehicleId            String?
  vehicle              Vehicle?      @relation(fields: [vehicleId], references: [id])
  cancelledBy          ActorType?
  cancelReason         CancelReason?
  cancelNote           String?
  assignedAt           DateTime?
  arrivedAt            DateTime?
  startedAt            DateTime?
  completedAt          DateTime?
  closedAt             DateTime?
  cancelledAt          DateTime?
  createdAt            DateTime      @default(now())
  stops                BookingStop[]
  history              BookingStatusHistory[]
  assignments          BookingAssignment[]
  offers               BookingOffer[]
  payments             Payment[]

  @@index([branchId, status, createdAt])
  @@index([driverId, status])
  @@index([passengerId, createdAt])
  @@index([scheduledAt])
  @@index([stripePaymentIntentId])
}

/// One collection attempt. Amounts are always written by the server; the client
/// never posts a figure. Booking.paymentStatus is updated in the same txn.
model Payment {
  id             String              @id @default(uuid())
  bookingId      String
  booking        Booking             @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  method         PaymentMethod
  /// CASH | FAKE | STRIPE. Server-set; not a client amount.
  provider       String
  purpose        PaymentPurpose      @default(TRIP_AUTH_CAPTURE)
  status         PaymentRecordStatus @default(PENDING)
  /// GST-inclusive amount for this attempt (server-computed).
  amountCents    Int
  currency       String              @default("CAD")
  /// Stripe PaymentIntent id (or gateway ref).
  providerRef    String?
  idempotencyKey String?             @unique
  failureCode    String?
  capturedAt     DateTime?
  createdById    String?
  createdAt      DateTime            @default(now())

  @@index([bookingId])
  @@index([provider, providerRef])
}

/// Chart-of-accounts style wallet. Keys are stable, e.g. DRIVER_BALANCE:<driverId>.
model FinancialAccount {
  id       String        @id @default(uuid())
  key      String        @unique
  type     AccountType
  branchId String?
  ownerId  String?
  currency String        @default("CAD")
  entries  LedgerEntry[]
}

/// One balanced money movement. Append-only; reverse via a new REVERSAL row.
model LedgerTransaction {
  id           String        @id @default(uuid())
  kind         LedgerKind
  sourceType   String // BOOKING | REVERSAL | LEASE | PAYOUT | ...
  sourceId     String
  branchId     String
  description  String?
  reversalOfId String?       @unique
  createdById  String?
  createdAt    DateTime      @default(now())
  entries      LedgerEntry[]

  @@unique([sourceType, sourceId, kind])
}

/// Debit positive, credit negative. Sum per transaction must be zero (DB trigger).
model LedgerEntry {
  id            String            @id @default(uuid())
  transactionId String
  transaction   LedgerTransaction @relation(fields: [transactionId], references: [id])
  accountId     String
  account       FinancialAccount  @relation(fields: [accountId], references: [id])
  amountCents   Int
  createdAt     DateTime          @default(now())

  @@index([accountId, createdAt])
  @@index([transactionId])
}

/// App-agnostic consent (e.g. LOCATION_TRACKING). Driver-specific notice rows stay on DriverLocationConsent.
model ConsentRecord {
  id         String   @id @default(uuid())
  userId     String
  type       String
  version    String
  appVersion String?
  acceptedAt DateTime @default(now())

  @@index([userId, type])
}

/// Saved Stripe PaymentMethod (card on file).
model PassengerPaymentMethod {
  id          String    @id @default(uuid())
  passengerId String
  passenger   Passenger @relation(fields: [passengerId], references: [id])
  stripePmId  String    @unique
  brand       String?
  last4       String?
  expMonth    Int?
  expYear     Int?
  isDefault   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  bookings    Booking[]

  @@index([passengerId])
}

/// Stripe Customer for a passenger (created on first card save).
model StripeCustomer {
  id               String    @id @default(uuid())
  passengerId      String    @unique
  passenger        Passenger @relation(fields: [passengerId], references: [id])
  stripeCustomerId String    @unique
  createdAt        DateTime  @default(now())
}

/// Deduplicates gateway webhook deliveries (Stripe retries the same event id).
model WebhookEvent {
  id          String    @id @default(uuid())
  provider    String // STRIPE
  eventId     String
  type        String
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  payload     Json

  @@unique([provider, eventId])
}

model LeaseAgreement {
  id                String    @id @default(uuid())
  driverId          String
  driver            Driver    @relation(fields: [driverId], references: [id])
  vehicleId         String
  vehicle           Vehicle   @relation(fields: [vehicleId], references: [id])
  weeklyAmountCents Int
  startDate         DateTime
  endDate           DateTime?
  active            Boolean   @default(true)
  createdById       String?
  createdAt         DateTime  @default(now())

  @@index([driverId, active])
}

/// Manual driver payout (no Stripe Connect yet).
model DriverPayout {
  id            String       @id @default(uuid())
  driverId      String
  driver        Driver       @relation(fields: [driverId], references: [id])
  branchId      String
  amountCents   Int
  status        PayoutStatus @default(PENDING)
  method        String // E_TRANSFER | DIRECT_DEPOSIT | CASH
  reference     String? // e-Transfer confirmation, bank ref, etc.
  requestedById String?
  requestedAt   DateTime     @default(now())
  sentAt        DateTime?
  sentById      String?
  failureNote   String?

  @@index([driverId, status])
}

/// Snapshot of a week's ledger balances. Never mutates LedgerEntry / LedgerTransaction.
model ClosingPeriod {
  id            String        @id @default(uuid())
  branchId      String
  branch        Branch        @relation(fields: [branchId], references: [id])
  weekStart     DateTime // UTC instant for branch-local week start
  weekEnd       DateTime
  status        ClosingStatus @default(DRAFT)
  finalizedAt   DateTime?
  finalizedById String?
  lines         ClosingLine[]
  createdAt     DateTime      @default(now())

  @@unique([branchId, weekStart])
}

model ClosingLine {
  id              String        @id @default(uuid())
  closingPeriodId String
  closingPeriod   ClosingPeriod @relation(fields: [closingPeriodId], references: [id])
  accountKey      String
  accountType     AccountType
  ownerId         String? // driverId when accountType is DRIVER_BALANCE
  openingCents    Int
  movementCents   Int
  closingCents    Int

  @@index([closingPeriodId])
}

model BookingStop {
  id        String    @id @default(uuid())
  bookingId String
  booking   Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  sequence  Int
  type      StopType
  address   String
  lat       Float
  lng       Float
  placeId   String?
  arrivedAt DateTime?

  @@unique([bookingId, sequence])
}

model BookingStatusHistory {
  id          String         @id @default(uuid())
  bookingId   String
  booking     Booking        @relation(fields: [bookingId], references: [id])
  fromStatus  BookingStatus?
  toStatus    BookingStatus
  actorType   ActorType
  actorUserId String?
  reason      String?
  metadata    Json?
  createdAt   DateTime       @default(now())

  @@index([bookingId, createdAt])
}

model BookingAssignment {
  id           String           @id @default(uuid())
  bookingId    String
  booking      Booking          @relation(fields: [bookingId], references: [id])
  driverId     String
  vehicleId    String
  method       AssignMethod
  assignedById String?
  assignedAt   DateTime         @default(now())
  endedAt      DateTime?
  endReason    AssignEndReason?

  @@index([driverId, assignedAt])
}

model BookingOffer {
  id                String      @id @default(uuid())
  bookingId         String
  booking           Booking     @relation(fields: [bookingId], references: [id])
  driverId          String
  driver            Driver      @relation(fields: [driverId], references: [id])
  vehicleId         String
  vehicle           Vehicle     @relation(fields: [vehicleId], references: [id])
  attempt           Int
  status            OfferStatus @default(OFFERED)
  distanceToPickupM Int
  offeredAt         DateTime    @default(now())
  expiresAt         DateTime
  respondedAt       DateTime?
  declineReason     String?

  @@index([bookingId, offeredAt])
  @@index([driverId, offeredAt])
}

/// Push token. Registration upserts by `token` (app-agnostic): same token moves
/// to the current user and clears revoke. Used by driver and passenger apps.
model DeviceToken {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  token      String    @unique
  platform   String // ios | android
  appVersion String?
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?

  @@index([userId])
}

model IdempotencyKey {
  id           String   @id @default(uuid())
  userId       String
  key          String
  requestHash  String
  responseCode Int?
  responseBody Json?
  createdAt    DateTime @default(now())

  @@unique([userId, key])
}
