# Canonical staging env template — no real secrets.
# Copy values into Railway/Render (or similar) per-environment UI only. Never commit filled files.
# Domain: staging-api.bridgecitycabs.com
# See docs/production-hardening.md § Environment split.

NODE_ENV=staging

# App role (bridgecabs_app) — DML only. Separate Neon project/branch from production.
DATABASE_URL=
# Migrator role — CI migrate deploy + nightly pg_dump only. Never the running container's DATABASE_URL.
MIGRATE_DATABASE_URL=
BACKUP_RETENTION_DAYS=30

# Separate Upstash (or equivalent) from production and local Docker.
REDIS_URL=

JWT_ACCESS_SECRET=
JWT_REFRESH_TTL_DAYS=7
QUOTE_SECRET=
OTP_PEPPER=
# Leave empty in staging — never ship a fixed OTP to a shared environment.
OTP_DEV_CODE=

SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=

API_PUBLIC_URL=https://staging-api.bridgecitycabs.com
# Explicit origins only — no wildcards. HTTP CORS + Socket.IO share this list.
WS_ALLOWED_ORIGINS=https://staging.bridgecitycabs.com

# Google — staging-restricted keys (API + referrer/bundle limits + billing alert).
GOOGLE_SERVER_API_KEY=
GOOGLE_PLACES_API_KEY=
GOOGLE_ROUTES_API_KEY=

# Stripe TEST keys only in staging. Never live keys here.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
AUTH_BUFFER_BPS=2000
ALLOW_FAKE_PAYMENTS=false

# Separate Firebase staging project (not the shared dev project, not production).
FIREBASE_SERVICE_ACCOUNT_JSON=

# Sentry project for staging (separate from production).
SENTRY_DSN=

# R2 staging bucket
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=bridgecabs-staging

QUOTE_TTL_SECONDS=600
FIXED_FARE_MAX_CENTS=50000
FIXED_FARE_INCLUDES_GST=false
PAYMENT_PENDING_ALERT_HOURS=12
MANUAL_WAIT_ALERT_MINUTES=5
CANDIDATE_RADIUS_KM=10
BOOKING_MIN_LEAD_MINUTES=15
BOOKING_MAX_ADVANCE_DAYS=30
PRESENCE_TTL_SECONDS=45
STALE_OFFLINE_AFTER_SECONDS=120
LOCATION_MIN_INTERVAL_MS=1000
LOCATION_RETENTION_DAYS=90
SOCKET_MAX_CONNECTIONS_PER_USER=4
SOCKET_EVENT_LIMIT=30
SOCKET_EVENT_WINDOW_SECONDS=10
LEASE_DEDUCTION_DAY=MON
PAYOUT_METHOD_DEFAULT=E_TRANSFER
INVOICE_DUE_DAYS=30
RATING_WINDOW_DAYS=14
TICKET_AUTO_REOPEN_ON_REPLY=true
SOS_BRANCH_FALLBACK_PHONE=
SOS_DEDUPE_WINDOW_SECONDS=30
REPORT_ASYNC_THRESHOLD_ROWS=5000
REPORT_MAX_RANGE_DAYS=180
REPORT_SIGNED_URL_TTL_SECONDS=3600
ROLLUP_JOB_HOUR_LOCAL=1
OFFER_TIMEOUT_SECONDS=15
SEARCH_WINDOW_SECONDS=120
SEARCH_RADII_KM=3,6,10
MAX_OFFERS_PER_BOOKING=6
SCHEDULE_LEAD_MINUTES=15
DRIVER_LOCATION_MAX_AGE_SECONDS=30
PUSH_ACK_WAIT_MS=2000
PASSENGER_LOCATION_INTERVAL_MS=3000
