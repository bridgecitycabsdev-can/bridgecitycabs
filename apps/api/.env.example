# Local docker-compose uses the owner role. Staging/production: this must be the
# bridgecabs_app DML-only role (see infrastructure/db-roles.sql). Never put the
# bridgecabs_migrator password in a running container as the app DATABASE_URL.
# Staging/production canonical templates: infrastructure/env/.env.*.example
DATABASE_URL="postgresql://bridgecabs:password@localhost:5432/bridgecabs?schema=public"
# Migrator role — CI `prisma migrate deploy` and the nightly pg_dump job only.
# Leave empty locally unless you are exercising DatabaseBackupService.
MIGRATE_DATABASE_URL=
# How long to keep R2/local nightly dumps (backups/bridgecabs_yyyy-MM-dd.sql.gz).
BACKUP_RETENTION_DAYS=30
JWT_ACCESS_SECRET=
JWT_REFRESH_TTL_DAYS=7
# Nest Throttler defaults (Redis). Raise only for local k6 (Day 14 load test).
# THROTTLE_LIMIT=100
# BOOKING_THROTTLE_LIMIT=10
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=
# AuditLog rows can contain phone numbers. Agree a retention period with counsel before production.
# Places API (New) and Geocoding API. Optional if GOOGLE_SERVER_API_KEY is set.
# The API proxies address search so this key stays off devices.
GOOGLE_PLACES_API_KEY=
# Optional Routes API override. Falls back to GOOGLE_SERVER_API_KEY.
GOOGLE_ROUTES_API_KEY=
# Server-only Google key for Places and Routes. Do not ship it to a browser or phone.
# Restrict it by API, set a per-API quota, and add a billing alert.
# Cloud hosts change outbound IPs, so do not rely on IP restriction.
GOOGLE_SERVER_API_KEY=<secret>
# HMAC secret for short-lived fare quote tokens.
QUOTE_SECRET=<openssl rand -hex 32>
QUOTE_TTL_SECONDS=600
FIXED_FARE_MAX_CENTS=50000
# false = dispatcher quotes the pre-GST amount; true = the fixed figure already includes GST.
# Ask dispatchers which number they tell the customer before flipping this.
FIXED_FARE_INCLUDES_GST=false
# Hours a PAYMENT_PENDING booking can sit before the daily job flags it for dispatch.
# Never auto-confirms money.
PAYMENT_PENDING_ALERT_HOURS=12
MANUAL_WAIT_ALERT_MINUTES=5
CANDIDATE_RADIUS_KM=10
BOOKING_MIN_LEAD_MINUTES=15
BOOKING_MAX_ADVANCE_DAYS=30
REDIS_URL=redis://localhost:6379
PRESENCE_TTL_SECONDS=45
STALE_OFFLINE_AFTER_SECONDS=120
LOCATION_MIN_INTERVAL_MS=1000
# Placeholder. Confirm this period with the insurer and legal counsel before production.
LOCATION_RETENTION_DAYS=90
SOCKET_MAX_CONNECTIONS_PER_USER=4
SOCKET_EVENT_LIMIT=30
SOCKET_EVENT_WINDOW_SECONDS=10
# Browser origins for sockets and credentialed CORS. Comma-separated.
# SameSite=Strict refresh cookies are sent only when the web app and API share a registrable domain.
# Mobile clients send no Origin header, so this list does not apply to them.
# Explicit origins only — no `*`. HTTP CORS and Socket.IO share this list.
# Staging/prod templates: infrastructure/env/.env.*.example
WS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001
OTP_PEPPER=
OTP_DEV_CODE=000000
# Dev-only FakeProvider for card flows without a gateway. Forbidden in production.
ALLOW_FAKE_PAYMENTS=true
# Stripe (Day 10). Test mode only until Day 14 production hardening.
# Create a Stripe account in test mode, enable CAD payments, and keep live keys out.
# Card numbers never touch this API — use PaymentSheet / Elements.
# Leave empty in local cash-only runs. Restrict keys in the Stripe Dashboard.
# Install the Stripe CLI for local webhooks (see docs/payments-ledger.md).
# `stripe listen --forward-to localhost:3000/api/v1/webhooks/stripe` prints whsec_... for STRIPE_WEBHOOK_SECRET.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# Authorization hold = quote total × (1 + AUTH_BUFFER_BPS/10000). Default 20%.
AUTH_BUFFER_BPS=2000
# Branch-local weekday the lease-deduction job runs (MON..SUN).
LEASE_DEDUCTION_DAY=MON
# Default method when an admin creates a DriverPayout.
PAYOUT_METHOD_DEFAULT=E_TRANSFER
# Days after send before a SENT/PARTIALLY_PAID invoice becomes OVERDUE.
INVOICE_DUE_DAYS=30
# Days after trip close during which passenger/driver may still rate.
RATING_WINDOW_DAYS=14
# When true, a requester reply on a RESOLVED ticket reopens it (support-desk convention).
TICKET_AUTO_REOPEN_ON_REPLY=true
# Optional SMS fallback when an SOS fires (socket alone only helps if dispatch is watching).
# Confirm with ops whether a phone-call escalation (not just SMS) should sit behind this.
SOS_BRANCH_FALLBACK_PHONE=
# Second SOS from the same user within this window updates lat/lng on the open alert (no new row).
SOS_DEDUPE_WINDOW_SECONDS=30
# Booking-report rows above this → BullMQ + R2 instead of sync HTTP stream.
REPORT_ASYNC_THRESHOLD_ROWS=5000
# Reject booking-report ranges wider than this many days (422 REPORT_RANGE_TOO_WIDE).
REPORT_MAX_RANGE_DAYS=180
# Signed URL lifetime for READY GeneratedReport downloads.
REPORT_SIGNED_URL_TTL_SECONDS=3600
# Branch-local hour (0–23) when the previous day's DailyBranchStat rollup runs.
ROLLUP_JOB_HOUR_LOCAL=1
# Public API origin used for local (non-R2) signed report download links.
API_PUBLIC_URL=http://localhost:3000
# Cloudflare R2 (S3-compatible). When unset, reports use local .data/object-storage/.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
OFFER_TIMEOUT_SECONDS=15
SEARCH_WINDOW_SECONDS=120
SEARCH_RADII_KM=3,6,10
MAX_OFFERS_PER_BOOKING=6
SCHEDULE_LEAD_MINUTES=15
DRIVER_LOCATION_MAX_AGE_SECONDS=30
PUSH_ACK_WAIT_MS=2000
PASSENGER_LOCATION_INTERVAL_MS=3000
# Empty logs pushes to the console. A service-account JSON sends them through FCM.
# iOS delivery also needs an APNs key on the Firebase app, and a real device.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Sentry DSN — leave empty locally. Scrubbing happens in beforeSend (see observability/sentry.ts).
SENTRY_DSN=
